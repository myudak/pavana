# No provider keys belong in the mobile bundle. This is the Pavana API origin only.
EXPO_PUBLIC_API_BASE_URL=https://app.pavana.myudak.com
# Bundled demo is the default. Set api to start with the backend instead.
EXPO_PUBLIC_DATA_SOURCE=demo

# Android standalone builds only. Restrict this Maps SDK key by package/signing certificate.
# This key becomes part of the Android binary; it is not a secret provider/server key.
GOOGLE_MAPS_ANDROID_API_KEY=

---
import { id } from '../../../web/src/lib/i18n/id';
const c = id.landing.how;
---

<section id="cara-kerja" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 md:px-8 md:py-28">
  <p class="text-xs font-semibold uppercase tracking-[0.24em] text-haze">{c.eyebrow}</p>
  <h2 class="mt-2 max-w-2xl font-heading text-3xl font-bold tracking-tight md:text-5xl">
    {c.title}
  </h2>

  <ol class="mt-10 grid gap-4 md:grid-cols-3">
    {
      c.steps.map((s, i) => (
        <li class="glass rounded-3xl p-6">
          <span class="flex size-10 items-center justify-center rounded-2xl bg-haze/15 font-heading text-lg font-bold text-haze">
            {i + 1}
          </span>
          <h3 class="mt-4 font-heading text-xl font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">{s.body}</p>
        </li>
      ))
    }
  </ol>

  <!-- The demo moment: same distance from the hotspot, different answer by wind direction. -->
  <div
    class="glass mt-6 grid items-center gap-8 overflow-hidden rounded-3xl p-6 md:grid-cols-2 md:p-10"
  >
    <div>
      <h3 class="font-heading text-2xl font-bold tracking-tight md:text-3xl">{c.diagramTitle}</h3>
      <p class="mt-3 leading-relaxed text-ink-muted">{c.diagramBody}</p>
    </div>
    <svg
      viewBox="0 0 360 240"
      class="w-full"
      role="img"
      aria-label={`${c.fire}, ${c.wind}: ${c.houseA}; ${c.houseB}`}
    >
      <defs>
        <linearGradient id="plume" x1="0" x2="1">
          <stop offset="0" stop-color="#f472b6" stop-opacity="0.75"></stop>
          <stop offset="1" stop-color="#a855f7" stop-opacity="0"></stop>
        </linearGradient>
        <marker
          id="arrow"
          viewBox="0 0 10 10"
          refX="6"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto"
        >
          <path d="M0 0 10 5 0 10z" fill="currentColor"></path>
        </marker>
      </defs>
      <!-- smoke plume drifting with the wind -->
      <path
        d="M70 120 C150 105 220 110 300 120 L300 150 C220 160 150 140 70 128 Z"
        fill="url(#plume)"></path>
      <!-- wind arrows (flow direction) -->
      <g
        class="text-ink-muted"
        stroke="currentColor"
        stroke-width="2"
        fill="none"
        stroke-linecap="round"
      >
        <path d="M60 40 H150" marker-end="url(#arrow)"></path>
        <path d="M60 64 H130" marker-end="url(#arrow)" opacity="0.6"></path>
      </g>
      <text x="60" y="28" class="fill-current text-ink-muted" font-size="12">{c.wind}</text>
      <!-- hotspot -->
      <circle cx="70" cy="124" r="16" fill="#f97316" opacity="0.25"></circle>
      <circle cx="70" cy="124" r="7" fill="#f97316"></circle>
      <text x="44" y="160" class="fill-current" font-size="12" font-weight="600">{c.fire}</text>
      <!-- equal-distance arc -->
      <path
        d="M255 124 A185 185 0 0 0 175 -20"
        fill="none"
        stroke="currentColor"
        stroke-dasharray="3 5"
        class="text-ink-muted"
        opacity="0.4"></path>
      <!-- house A: downwind -->
      <g transform="translate(255 108)">
        <circle cx="12" cy="12" r="24" fill="#f472b6" opacity="0.18"></circle>
        <path d="M0 12 L12 0 L24 12 V26 H0 Z" fill="#f472b6"></path>
      </g>
      <text x="212" y="166" class="fill-current" font-size="12" font-weight="600">{c.houseA}</text>
      <!-- house B: crosswind, same distance -->
      <g transform="translate(160 6)">
        <circle cx="12" cy="12" r="24" fill="#a78bfa" opacity="0.18"></circle>
        <path d="M0 12 L12 0 L24 12 V26 H0 Z" fill="#a78bfa"></path>
      </g>
      <text x="196" y="26" class="fill-current" font-size="12" font-weight="600">{c.houseB}</text>
    </svg>
  </div>
</section>

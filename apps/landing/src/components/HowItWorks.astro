---
import { id } from '../../../web/src/lib/i18n/id';
const c = id.landing.how;

// Mini-map geometry: fire at F, both houses on a circle of radius R around it.
const F = { x: 120, y: 135 };
const R = 108;
const A = { x: F.x + R, y: F.y }; // downwind (wind blows → east)
const angleB = (-62 * Math.PI) / 180;
const B = { x: F.x + R * Math.cos(angleB), y: F.y + R * Math.sin(angleB) }; // crosswind
---

<section id="cara-kerja" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 md:px-8 md:py-28">
  <p class="text-xs font-semibold uppercase tracking-[0.24em] text-haze">{c.eyebrow}</p>
  <h2 class="mt-2 max-w-2xl font-heading text-3xl font-bold tracking-tight md:text-5xl">
    {c.title}
  </h2>

  <ol class="mt-10 grid gap-4 md:grid-cols-3">
    {
      c.steps.map((s, i) => (
        <li class="glass rounded-3xl p-6">
          <span class="flex size-10 items-center justify-center rounded-2xl bg-haze/15 font-heading text-lg font-bold text-haze">
            {i + 1}
          </span>
          <h3 class="mt-4 font-heading text-xl font-semibold">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-muted">{s.body}</p>
        </li>
      ))
    }
  </ol>

  <!-- The demo moment: same distance from the hotspot, different answer by wind direction. -->
  <div class="glass mt-6 grid items-center gap-8 rounded-3xl p-5 md:grid-cols-2 md:p-10">
    <div>
      <h3 class="font-heading text-2xl font-bold tracking-tight md:text-3xl">{c.diagramTitle}</h3>
      <p class="mt-3 leading-relaxed text-ink-muted">{c.diagramBody}</p>
    </div>

    <div class="space-y-3">
      <div class="overflow-hidden rounded-2xl border border-border bg-surface-muted">
        <svg
          viewBox="0 0 400 260"
          class="block w-full"
          role="img"
          aria-label={`${c.fire}; ${c.wind}; ${c.houseA}: ${c.levelA}; ${c.houseB}: ${c.levelB}`}
        >
          <defs>
            <pattern id="grid" width="24" height="24" patternUnits="userSpaceOnUse">
              <path d="M24 0H0V24" fill="none" stroke="currentColor" stroke-opacity="0.07"></path>
            </pattern>
            <linearGradient id="plume" x1="0" x2="1">
              <stop offset="0" stop-color="#f472b6" stop-opacity="0.85"></stop>
              <stop offset="0.6" stop-color="#c084fc" stop-opacity="0.45"></stop>
              <stop offset="1" stop-color="#818cf8" stop-opacity="0"></stop>
            </linearGradient>
            <radialGradient id="glow">
              <stop offset="0" stop-color="#f97316" stop-opacity="0.55"></stop>
              <stop offset="1" stop-color="#f97316" stop-opacity="0"></stop>
            </radialGradient>
          </defs>
          <rect width="400" height="260" fill="url(#grid)" class="text-ink"></rect>

          <!-- wind: flow lines to the east -->
          <g class="text-ink-muted" stroke="currentColor" stroke-linecap="round" fill="none">
            {
              [82, 214, 238].map((y, i) => (
                <g opacity={0.5 - i * 0.1}>
                  <path
                    d={`M${20 + i * 30} ${y} H${330 + i * 10}`}
                    stroke-width="1.5"
                    stroke-dasharray="2 7"
                  />
                  <path d={`M${322 + i * 10} ${y - 5} l8 5 -8 5`} stroke-width="1.5" />
                </g>
              ))
            }
          </g>

          <!-- equal distance -->
          <circle
            cx={F.x}
            cy={F.y}
            r={R}
            fill="none"
            stroke="currentColor"
            stroke-dasharray="4 6"
            class="text-ink-muted"
            stroke-opacity="0.55"></circle>

          <!-- smoke plume drifting downwind -->
          <path
            d={`M${F.x} ${F.y - 6} C${F.x + 90} ${F.y - 26} ${F.x + 200} ${F.y - 34} 395 ${F.y - 30} L395 ${F.y + 34} C${F.x + 200} ${F.y + 34} ${F.x + 90} ${F.y + 22} ${F.x} ${F.y + 6} Z`}
            fill="url(#plume)"></path>

          <!-- hotspot -->
          <circle cx={F.x} cy={F.y} r="30" fill="url(#glow)"></circle>
          <circle cx={F.x} cy={F.y} r="8" fill="#f97316" stroke="#fff" stroke-width="2"></circle>

          <!-- pins -->
          <g>
            <circle cx={A.x} cy={A.y} r="17" fill="#db2777" stroke="#fff" stroke-width="2.5"
            ></circle>
            <text
              x={A.x}
              y={A.y + 5}
              text-anchor="middle"
              font-size="15"
              font-weight="700"
              fill="#fff">A</text
            >
          </g>
          <g>
            <circle cx={B.x} cy={B.y} r="17" fill="#7c3aed" stroke="#fff" stroke-width="2.5"
            ></circle>
            <text
              x={B.x}
              y={B.y + 5}
              text-anchor="middle"
              font-size="15"
              font-weight="700"
              fill="#fff">B</text
            >
          </g>
        </svg>
      </div>

      <div class="flex flex-wrap gap-x-4 gap-y-1 px-1 text-xs text-ink-muted">
        <span class="inline-flex items-center gap-1.5"
          ><span class="size-2.5 rounded-full bg-[#f97316]"></span>{c.fire}</span
        >
        <span class="inline-flex items-center gap-1.5"
          ><span class="text-sm leading-none">→</span>{c.wind}</span
        >
        <span>{c.sameDistance}</span>
      </div>

      <ul class="space-y-2">
        <li class="flex items-center justify-between gap-3 rounded-2xl bg-[#db2777]/10 px-4 py-3">
          <span class="flex items-center gap-3 font-medium">
            <span
              class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#db2777] text-sm font-bold text-white"
              >A</span
            >
            {c.houseA}
          </span>
          <span class="rounded-full bg-[#db2777] px-3 py-1 text-xs font-bold text-white">
            {c.levelA}
          </span>
        </li>
        <li class="flex items-center justify-between gap-3 rounded-2xl bg-[#7c3aed]/10 px-4 py-3">
          <span class="flex items-center gap-3 font-medium">
            <span
              class="flex size-7 shrink-0 items-center justify-center rounded-full bg-[#7c3aed] text-sm font-bold text-white"
              >B</span
            >
            {c.houseB}
          </span>
          <span class="rounded-full bg-[#7c3aed] px-3 py-1 text-xs font-bold text-white">
            {c.levelB}
          </span>
        </li>
      </ul>
    </div>
  </div>
</section>

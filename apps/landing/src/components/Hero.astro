---
import { ArrowRight01Icon, PlayCircleIcon } from '@hugeicons/core-free-icons';
import sunset from '@pavana/brand/backgrounds/sunset.webp';
import sunset900 from '@pavana/brand/backgrounds/sunset-900.webp';
import { id } from '../../../web/src/lib/i18n/id';
import Icon from './Icon.astro';
import PhoneMock from './PhoneMock.astro';

interface Props {
  appUrl: string;
}
const { appUrl } = Astro.props;
const h = id.landing.hero;
const demoUrl = `${appUrl.replace(/\/$/, '')}/?demo=1`;
---

<section class="relative isolate overflow-hidden text-white">
  <!-- Full-bleed photo; scrim keeps white text readable in both themes. -->
  <img
    src={sunset.src}
    srcset={`${sunset900.src} 900w, ${sunset.src} 1672w`}
    sizes="100vw"
    alt=""
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full animate-drift object-cover object-[65%_center] motion-reduce:animate-none"
  />
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10"
    style="background: linear-gradient(180deg, rgba(14,17,32,0.65) 0%, rgba(14,17,32,0.35) 35%, rgba(14,17,32,0.55) 70%, var(--pv-canvas) 100%)"
  >
  </div>

  <div
    class="mx-auto grid max-w-6xl items-center gap-14 px-4 pb-24 pt-28 md:grid-cols-[1.1fr_0.9fr] md:px-8 md:pb-32 md:pt-36"
  >
    <div class="space-y-6">
      <p
        class="inline-flex rounded-full border border-white/20 bg-white/10 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.24em] backdrop-blur"
      >
        {h.category}
      </p>
      <h1
        class="font-heading text-[2.6rem] font-bold leading-[1.02] tracking-tight drop-shadow md:text-6xl lg:text-7xl"
      >
        {h.heading[0]}<br />
        <span
          class="bg-gradient-to-r from-[#fbcfe8] via-[#f472b6] to-[#a5b4fc] bg-clip-text text-transparent"
        >
          {h.heading[1]}
        </span>
      </h1>
      <p class="max-w-xl text-base leading-relaxed text-white/85 md:text-lg">{h.introduction}</p>
      <div class="flex flex-wrap gap-3">
        <a
          href={appUrl}
          class="inline-flex h-12 items-center gap-2 rounded-full bg-white px-6 font-semibold text-[#1e1b4b] shadow-lg transition hover:bg-white/90"
        >
          {h.ctaPrimary}
          <Icon icon={ArrowRight01Icon} class="size-4" />
        </a>
        <a
          href={demoUrl}
          class="glass-dark inline-flex h-12 items-center gap-2 rounded-full px-6 font-semibold text-white transition hover:bg-white/15"
        >
          <Icon icon={PlayCircleIcon} class="size-4" />
          {h.ctaDemo}
        </a>
      </div>
      <p class="max-w-lg text-sm text-white/70">{h.demoStatus}</p>
    </div>

    <PhoneMock />
  </div>
</section>

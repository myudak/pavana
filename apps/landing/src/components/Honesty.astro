---
// Principles only; the source list lives in Sources.astro (one status array in id.landing.sources).
import { CheckmarkCircle02Icon } from '@hugeicons/core-free-icons';
import Icon from './Icon.astro';

const principles = [
  'Titik panas adalah deteksi anomali panas oleh satelit — bukan konfirmasi kebakaran.',
  'PM2.5 berasal dari banyak sumber; kenaikannya tidak otomatis disebabkan kebakaran tertentu.',
  'Pavana tidak memprediksi penyebaran api dan tidak memberi perintah evakuasi.',
  'Setiap angka disertai sumber, jenis data (pengamatan/prakiraan/demo), dan waktu berlaku.',
];
---

<section class="border-y border-border bg-surface-muted/60">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 md:grid-cols-[0.9fr_1.1fr] md:px-8 md:py-24">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.24em] text-haze">Prinsip</p>
      <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight md:text-4xl">
        Jujur soal ketidakpastian.
      </h2>
    </div>
    <ul class="space-y-3">
      {
        principles.map((p) => (
          <li class="glass flex gap-3 rounded-2xl p-4 text-sm leading-relaxed">
            <Icon icon={CheckmarkCircle02Icon} class="mt-0.5 size-5 text-haze" />
            <span>{p}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
import { id } from '../../../web/src/lib/i18n/id';

const q = id.landing.questions;
// FAQPage structured data from the same visible copy (no hidden or extra claims).
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: q.items.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<section
  id="faq"
  aria-labelledby="tentang-pavana"
  class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 md:px-8 md:py-28"
>
  <p class="text-xs font-semibold uppercase tracking-[0.24em] text-haze">FAQ</p>
  <h2 id="tentang-pavana" class="mt-2 font-heading text-3xl font-bold tracking-tight md:text-4xl">
    {q.title}
  </h2>
  <div class="mt-8 max-w-3xl space-y-3">
    {
      q.items.map(({ question, answer }, i) => (
        <details class="glass group rounded-2xl p-5" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-heading text-lg font-semibold">
            {question}
            <span
              class="mt-1 text-haze transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="mt-3 leading-relaxed text-ink-muted">{answer}</p>
        </details>
      ))
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>

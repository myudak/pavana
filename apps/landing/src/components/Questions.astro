---
import { id } from '../../../web/src/lib/i18n/id';
---

<section aria-labelledby="tentang-pavana" class="border-t border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-20 md:px-8">
    <h2 id="tentang-pavana" class="font-display text-3xl font-medium tracking-tight md:text-4xl">
      {id.landing.questions.title}
    </h2>
    <dl class="mt-8 max-w-3xl divide-y divide-border">
      {
        id.landing.questions.items.map(({ question, answer }) => (
          <div class="py-6 first:pt-0 last:pb-0">
            <dt class="font-display text-xl font-medium">{question}</dt>
            <dd class="mt-3 leading-relaxed text-ink-muted">{answer}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

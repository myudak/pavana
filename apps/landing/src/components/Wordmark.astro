---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- Identitas Pavana = wordmark "pavana" saja. Utilitas `font-wordmark` = Vernosa
  (pending, lihat packages/brand/src/fonts.css) dengan fallback Comfortaa interim. -->
<span
  class:list={['inline-flex items-center', !/\btext-/.test(className) && 'text-ink', className]}
>
  <span class="font-wordmark text-2xl font-bold tracking-[-0.05em]">pavana</span>
</span>

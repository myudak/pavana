---
const features = [
  {
    title: 'Hari Ini',
    body: 'Kondisi PM2.5 dan arah perubahannya dalam 24 jam ke depan, dalam bahasa yang mudah dipahami.',
  },
  {
    title: 'Peta',
    body: 'Titik panas satelit dan arah angin di sekitarmu, lengkap dengan waktu deteksi dan sumbernya.',
  },
  {
    title: 'Insight',
    body: 'Faktor yang mungkin memengaruhi kualitas udara — angin, titik panas searah angin, dan tren prakiraan.',
  },
];
---

<section id="cara-kerja" class="border-y border-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-20 md:px-8">
    <h2 class="font-display text-3xl font-bold tracking-tight md:text-4xl">
      Semudah aplikasi cuaca.
    </h2>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Dirancang untuk warga di sekitar wilayah rawan kebakaran hutan dan lahan gambut — bukan dasbor
      GIS profesional.
    </p>
    <ul class="mt-10 grid gap-4 md:grid-cols-3">
      {
        features.map((f, i) => (
          <li class="rounded-[1.25rem] border border-border bg-canvas p-6">
            <p class="font-display text-sm text-primary-strong">0{i + 1}</p>
            <h3 class="mt-2 font-display text-xl font-bold">{f.title}</h3>
            <p class="mt-2 text-sm text-ink-muted">{f.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
import Features from '../components/Features.astro';
import Hero from '../components/Hero.astro';
import Honesty from '../components/Honesty.astro';
import Problem from '../components/Problem.astro';
import Questions from '../components/Questions.astro';
import Team from '../components/Team.astro';
import Wordmark from '../components/Wordmark.astro';
import Base from '../layouts/Base.astro';

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';
---

<Base>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-4 py-5 md:px-8">
    <Wordmark />
    <a
      href={appUrl}
      class="rounded-full px-4 py-2 text-sm font-medium text-primary-strong hover:bg-primary-soft"
    >
      Buka aplikasi →
    </a>
  </header>

  <main>
    <Hero appUrl={appUrl} />
    <Problem />
    <Features />
    <Honesty />
    <Questions />
    <Team />
  </main>

  <footer class="border-t border-border">
    <div
      class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-ink-muted md:flex-row md:justify-between md:px-8"
    >
      <p>Pavana · JOINTS 2026 · Sustainability</p>
      <p>Bukan sumber peringatan resmi. Ikuti arahan BMKG dan BPBD setempat.</p>
    </div>
  </footer>
</Base>

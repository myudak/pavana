---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Pavana — Prakiraan kualitas udara & asap kebakaran',
  description = 'Prakiraan kualitas udara dan potensi dampak asap kebakaran, berdasarkan lokasimu.',
} = Astro.props;

// C4: URL absolut OG/canonical mengikuti `site` di astro.config.mjs — saat ini masih
// placeholder `pavana.example` (lihat C5). Ganti site saat domain final dipilih.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.svg', Astro.site).href : '/og.svg';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pavana" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      // Same preference key as the app; resolves before paint.
      (() => {
        let pref = 'system';
        try {
          pref = localStorage.getItem('pavana:theme') || 'system';
        } catch {
          // storage blocked — fall back to the OS preference
        }
        const dark =
          pref === 'dark' ||
          (pref === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-canvas text-ink">
    <slot />
  </body>
</html>

# Copy to `.env` at the repo root. Nothing here is required for demo mode.

# ---------- API (apps/api) ----------
# demo = serve the synthetic Kubu Raya fixture (no keys needed)
# live = real data (Open-Meteo + CAMS, BMKG work without keys; FIRMS and OpenAQ need the keys below)
#        `?demo=1` on any request still serves the fixture scenario.
PAVANA_MODE=demo
API_PORT=8787
API_HOST=127.0.0.1
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4321
# true behind a reverse proxy (Vercel) so rate limiting uses the client IP
TRUST_PROXY=false

# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/). Server-side only.
FIRMS_MAP_KEY=

# OpenAQ v3 API key (https://explore.openaq.org/register). Server-side only.
OPENAQ_API_KEY=
# Tanya Pavi LLM (server-side only). Optional: without it the chat says it is unavailable.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# ---------- Web app (apps/web) ----------
# Optional MapLibre style overrides. Empty = free CARTO basemaps (OSM data):
# Voyager in light mode, Dark Matter in dark mode. See docs/data-sources.md → Map tiles.
VITE_MAP_STYLE_URL=
VITE_MAP_STYLE_URL_DARK=

# ---------- Landing (apps/landing) ----------
PUBLIC_APP_URL=http://localhost:5173
